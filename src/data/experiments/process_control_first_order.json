{
  "experiment_id": "exp1-first-order-system-response",
  "subject": "instrumentation-process-control",
  "subject_name": "Process Control Lab",
  "title": "Response of First-Order System",
  "short_name": "First-Order System",
  "aim": "To study the behavior and determine the time constant of a first-order process subjected to step and sinusoidal heat input changes.",
  "apparatus": [
    "Thermocouple / RTD / Mercury thermometer",
    "Circulating water bath with electric heater",
    "Stopwatch",
    "Cyclic timer (ON/OFF)"
  ],
  "materials": [
    "Clean water",
    "Ice cubes"
  ],
  "parts": [
    {
      "id": "partA",
      "title": "Part A: Step Input Response",
      "short_title": "Part A — Step Input",
      "aim": "To study the behavior and to determine the time constant of a first-order process subjected to a step change in heat input (thermometer/thermocouple immersed in a heating bath).",
      "system": "Changes in the temperature of a fluid due to step changes in the external heat supply.",
      "theory": "Heat transfer between the heating bath surroundings at temperature T_s and the temperature sensor (thermocouple/RTD/thermometer) at temperature T' is governed by a first-order dynamic energy balance.\n\nAssumptions:\n(i) Uniform bead temperature (no gradients in thermocouple bead)\n(ii) No conduction in the leads\n(iii) Constant physical properties (density, specific heat, heat transfer coefficient)\n(iv) Fast sensor millivolt-to-°C conversion with zero dynamics\n\nEnergy Balance:\nhA(T - T_s) = m C_p (dT'/dt)\n\nAt Steady State:\nhA(T_s - T_s') = m C_p (dT_s'/dt) = 0\n\nIntroducing Deviation Variables T̄ = T - T_s and T̄' = T' - T_s':\nhA(T̄ - T̄') = m C_p (dT̄'/dt) => T̄ - T̄' = τ (dT̄'/dt)\nwhere τ = (m C_p) / (h A) is the time constant.\n\nLaplace Domain Transfer Function:\nT̄'(s) / T̄(s) = 1 / (τs + 1) = K e^{-Ds} / (τs + 1)\n\nStep Response Solution:\nT̄'(t) = K (1 - e^{-(t-D)/τ})\nAt t = τ, T̄'(τ) = 0.632 × ΔT (63.2% of total temperature rise).",
      "formulas": [
        {
          "id": "energy_balance",
          "label": "Sensor Energy Balance",
          "latex": "hA(T - T_s) = m C_p \\frac{dT'}{dt}",
          "derivation": "Dynamic heat transfer from bath surroundings at T_s to sensor bead at T'.",
          "purpose": "Establishes dynamic thermal equilibrium for the sensor.",
          "variables": [
            { "symbol": "m", "meaning": "Mass of sensor / thermocouple fluid", "unit": "g", "typical_range": "1.0 g" },
            { "symbol": "C_p", "meaning": "Specific heat capacity", "unit": "cal/g·°C", "typical_range": "0.25 cal/g·°C" },
            { "symbol": "h", "meaning": "Heat transfer coefficient", "unit": "cal/cm²·h·°C", "typical_range": "12.0 cal/cm²·h·°C" },
            { "symbol": "A", "meaning": "Surface area of sensor bead", "unit": "cm²", "typical_range": "7.5 cm²" }
          ],
          "assumptions": ["Uniform bead temperature", "No lead conduction", "Constant physical properties", "Fast sensor response"]
        },
        {
          "id": "time_constant_definition",
          "label": "Time Constant (τ)",
          "latex": "\\tau = \\frac{m C_p}{h A}",
          "derivation": "Defined by grouping physical properties m C_p divided by h A.",
          "purpose": "Measures system response speed. Smaller τ means faster response.",
          "variables": [
            { "symbol": "τ", "meaning": "System time constant", "unit": "sec", "typical_range": "5 – 25 s" },
            { "symbol": "m", "meaning": "Sensor mass", "unit": "g", "typical_range": "1.0 g" },
            { "symbol": "C_p", "meaning": "Specific heat", "unit": "cal/g·°C", "typical_range": "0.25" },
            { "symbol": "h", "meaning": "Heat transfer coefficient", "unit": "cal/cm²·h·°C", "typical_range": "12.0" },
            { "symbol": "A", "meaning": "Surface area", "unit": "cm²", "typical_range": "7.5" }
          ],
          "assumptions": ["Ideal lumped capacitance system"]
        }
      ],
      "calculation_steps": [
        {
          "step_id": "dT",
          "step_number": 1,
          "label": "Step 1: Steady-State Temperature Span (ΔT)",
          "formula_latex": "\\Delta T = T_{final} - T_{initial}",
          "formula_expression": "T_final - T_initial",
          "substitution_template": "\\Delta T = {T_final} - {T_initial}",
          "depends_on": ["T_final", "T_initial"],
          "unit": "°C",
          "format": "decimal",
          "decimal_precision": 1
        },
        {
          "step_id": "tau_theo",
          "step_number": 2,
          "label": "Step 2: Theoretical Sensor Time Constant (τ)",
          "formula_latex": "\\tau = \\frac{m C_p}{h A}",
          "formula_expression": "(m * Cp) / (h * A / 3600)",
          "substitution_template": "\\tau = \\frac{{m} \\times {Cp}}{{h} \\times {A} / 3600}",
          "simplification_template": "\\tau = \\frac{0.25}{0.025}",
          "depends_on": ["m", "Cp", "h", "A"],
          "unit": "sec",
          "format": "decimal",
          "decimal_precision": 2
        },
        {
          "step_id": "T_dev_heat",
          "step_number": 3,
          "label": "Step 3: Heating Temperature Deviation (T̄'(t))",
          "formula_latex": "\\bar{T}'(t) = T_{rise} - T_{initial}",
          "formula_expression": "T_rise - T_initial",
          "substitution_template": "\\bar{T}'(t) = {T_rise} - {T_initial}",
          "depends_on": ["T_rise", "T_initial"],
          "unit": "°C",
          "format": "decimal",
          "decimal_precision": 1
        }
      ],
      "fixed_inputs": [
        { "id": "m", "label": "Mass of sensor (m)", "value": 1.0, "unit": "g", "description": "Mass of fluid/thermocouple (1 g)" },
        { "id": "Cp", "label": "Specific heat (Cp)", "value": 0.25, "unit": "cal/g·°C", "description": "Specific heat of fluid/sensor" },
        { "id": "h", "label": "Heat transfer coeff (h)", "value": 12.0, "unit": "cal/cm²·h·°C", "description": "Heat transfer coefficient" },
        { "id": "A", "label": "Surface area (A)", "value": 7.5, "unit": "cm²", "description": "Surface area of sensor" },
        { "id": "T_initial", "label": "Room/Initial Temp (T_initial)", "value": 25.0, "unit": "°C", "description": "Initial steady temperature" },
        { "id": "T_final", "label": "Final Steady Temp (T_final)", "value": 51.0, "unit": "°C", "description": "Final steady temperature" }
      ],
      "trial_inputs": [
        { "id": "t", "label": "Time (t)", "unit": "s", "type": "number", "placeholder": "e.g. 10", "tooltip": "Elapsed time in seconds" },
        { "id": "T_rise", "label": "Rise in Temp (°C) [Heating]", "unit": "°C", "type": "number", "placeholder": "e.g. 45", "tooltip": "Observed temperature during heating" },
        { "id": "T_fall", "label": "Fall in Temp (°C) [Cooling]", "unit": "°C", "type": "number", "placeholder": "e.g. 32", "tooltip": "Observed temperature during cooling" }
      ],
      "calculations": {
        "dT": "T_final - T_initial",
        "K": "(T_final - T_initial) / ((V / 100) * 230 * 5 * 0.05)",
        "tau_theo": "(m * Cp) / (h * A / 3600)",
        "T_dev_heat": "T_rise - T_initial",
        "T_dev_cool": "T_fall - T_final",
        "norm_heat": "(T_rise - T_initial) / 10",
        "norm_cool": "T_fall / 10",
        "T_theo": "T_initial + (T_final - T_initial) * (1 - exp(-1 * t / 10))"
      },
      "calculated_columns": [
        { "id": "T_dev_heat", "label": "T̄'(t) Heating", "unit": "°C", "format": "decimal" },
        { "id": "norm_heat", "label": "T̄'(t)/τ Heating", "unit": "-", "format": "decimal" },
        { "id": "T_dev_cool", "label": "T̄'(t) Cooling", "unit": "°C", "format": "decimal" },
        { "id": "norm_cool", "label": "T̄'(t)/τ Cooling", "unit": "-", "format": "decimal" },
        { "id": "T_theo", "label": "T_theo (t)", "unit": "°C", "format": "decimal" }
      ],
      "validation_ranges": {
        "t": { "min": 0, "max": 600, "label": "Time (s)" },
        "T_rise": { "min": 10, "max": 100, "label": "Heating Temp (°C)" },
        "T_fall": { "min": 10, "max": 100, "label": "Cooling Temp (°C)" }
      },
      "sample_data": [
        { "t": 0, "T_rise": 25, "T_fall": 51 },
        { "t": 5, "T_rise": 35, "T_fall": 40.77 },
        { "t": 10, "T_rise": 41.4, "T_fall": 34.56 },
        { "t": 15, "T_rise": 45.2, "T_fall": 30.8 },
        { "t": 20, "T_rise": 47.5, "T_fall": 28.5 },
        { "t": 25, "T_rise": 48.9, "T_fall": 27.13 },
        { "t": 30, "T_rise": 49.7, "T_fall": 26.3 },
        { "t": 100, "T_rise": 50.99, "T_fall": 25.0 }
      ],
      "graph": {
        "type": "first_order_step",
        "x": "t",
        "y": "norm_heat",
        "x_label": "Time / τ",
        "y_label": "T̄'(t) / K",
        "title": "First-Order Step Response (Experimental vs Theoretical 63.2% Curve)"
      }
    },
    {
      "id": "partB",
      "title": "Part B: Sinusoidal Input Response",
      "short_title": "Part B — Sinusoidal Input",
      "aim": "To study the sinusoidal response of a thermowell/thermocouple in a circulating water bath to a sinusoidal (cyclic ON/OFF) heat input, and compare input vs output temperature-time curves, amplitude ratio, frequency of oscillation, time constant, phase lag, and normalized output deviation.",
      "system": "Thermowell in a circulating water bath subjected to periodic cyclic heating.",
      "theory": "The dynamic response of a first-order thermal instrument to a sinusoidal temperature variation is governed by:\n\n1) I/p amplitude = (max Bath temp - min Bath temp) / 2 = (48 - 28) / 2 = 10 °C\n2) O/p amplitude = (max Thermowell - min Thermowell) / 2 = (43 - 37) / 2 = 3 °C\n3) Amplitude Ratio (AR) = (O/p amplitude) / (I/p amplitude) = 3 / 10 = 0.3\n4) Freq of oscillation (ω) = 2π / 60 = 0.105 rad/s\n5) Time constant (τ) = √(1 - AR²) / (AR × Freq) = √(1 - 0.3²) / (0.3 × 0.1047) = 30.36 s\n6) Phase lag (φ) = (observed phase lag × 360) / 60 = 60°\n7) Normalized output deviation (θ/A) = 0.1365",
      "formulas": [
        {
          "id": "ip_amplitude",
          "label": "i) Input Amplitude (I/p Amplitude)",
          "latex": "\\text{I/p Amplitude} = \\frac{\\text{max Bath Temp} - \\text{min Bath Temp}}{2}",
          "derivation": "Calculates half peak-to-peak amplitude of input water bath temperature oscillation.",
          "purpose": "Establishes input wave amplitude A₁.",
          "variables": [
            { "symbol": "max Bath Temp", "meaning": "Maximum recorded input bath temperature", "unit": "°C", "typical_range": "48 °C" },
            { "symbol": "min Bath Temp", "meaning": "Minimum recorded input bath temperature", "unit": "°C", "typical_range": "28 °C" },
            { "symbol": "I/p Amplitude", "meaning": "Input sinusoidal wave amplitude A₁", "unit": "°C", "typical_range": "10 °C" }
          ]
        },
        {
          "id": "op_amplitude",
          "label": "ii) Output Amplitude (O/p Amplitude)",
          "latex": "\\text{O/p Amplitude} = \\frac{\\text{max Thermowell} - \\text{min Thermowell}}{2}",
          "derivation": "Calculates half peak-to-peak amplitude of output thermowell sensor temperature.",
          "purpose": "Establishes output wave amplitude A₂.",
          "variables": [
            { "symbol": "max Thermowell", "meaning": "Maximum recorded output sensor temperature", "unit": "°C", "typical_range": "43 °C" },
            { "symbol": "min Thermowell", "meaning": "Minimum recorded output sensor temperature", "unit": "°C", "typical_range": "37 °C" },
            { "symbol": "O/p Amplitude", "meaning": "Output sinusoidal wave amplitude A₂", "unit": "°C", "typical_range": "3 °C" }
          ]
        },
        {
          "id": "amplitude_ratio",
          "label": "iii) Amplitude Ratio (AR)",
          "latex": "\\text{Amplitude Ratio (AR)} = \\frac{\\text{O/p Amplitude}}{\\text{I/p Amplitude}} = \\frac{A_2}{A_1}",
          "derivation": "Ratio of output wave amplitude to input wave amplitude.",
          "purpose": "Measures attenuation of signal (AR ≤ 1.0 for first-order lag)."
        },
        {
          "id": "freq_oscillation",
          "label": "iv) Frequency of Oscillation (ω)",
          "latex": "\\text{Freq of Oscillation } (\\omega) = \\frac{2\\pi}{60}",
          "derivation": "Circular frequency for period T = 60 seconds.",
          "purpose": "Calculates input cycle frequency in rad/s."
        },
        {
          "id": "time_constant_ar_exact",
          "label": "v) Time Constant (τ)",
          "latex": "\\tau = \\frac{\\sqrt{1 - AR^2}}{AR \\cdot \\text{Freq}}",
          "derivation": "Solved by rearranging AR = 1 / √(1 + (ωτ)²).",
          "purpose": "Calculates first-order system time constant from amplitude ratio and frequency."
        },
        {
          "id": "phase_lag_exact",
          "label": "vi) Phase Lag (φ)",
          "latex": "\\text{Phase Lag } (\\phi) = \\frac{\\text{observed phase lag} \\times 360}{60}",
          "derivation": "Converts observed peak time delay in seconds into angular degrees.",
          "purpose": "Calculates phase lag angle in degrees."
        }
      ],
      "calculation_steps": [
        {
          "step_id": "ip_amp",
          "step_number": 1,
          "label": "Step 1: Input Bath Temperature Amplitude (A1)",
          "formula_latex": "A_1 = \\frac{\\text{max Bath} - \\text{min Bath}}{2}",
          "formula_expression": "(input_max - input_min) / 2",
          "substitution_template": "A_1 = \\frac{{input_max} - {input_min}}{2}",
          "simplification_template": "A_1 = \\frac{20.0}{2}",
          "depends_on": ["input_max", "input_min"],
          "unit": "°C",
          "format": "decimal",
          "decimal_precision": 1,
          "feeds_into": "Step 3: Amplitude Ratio (AR)"
        },
        {
          "step_id": "op_amp",
          "step_number": 2,
          "label": "Step 2: Output Sensor Temperature Amplitude (A2)",
          "formula_latex": "A_2 = \\frac{\\text{max Thermowell} - \\text{min Thermowell}}{2}",
          "formula_expression": "(op_max - op_min) / 2",
          "substitution_template": "A_2 = \\frac{{op_max} - {op_min}}{2}",
          "simplification_template": "A_2 = \\frac{6.0}{2}",
          "depends_on": ["op_max", "op_min"],
          "unit": "°C",
          "format": "decimal",
          "decimal_precision": 1,
          "feeds_into": "Step 3: Amplitude Ratio (AR)"
        },
        {
          "step_id": "AR",
          "step_number": 3,
          "label": "Step 3: Amplitude Ratio (AR)",
          "formula_latex": "AR = \\frac{A_2}{A_1}",
          "formula_expression": "((op_max - op_min) / 2) / ((input_max - input_min) / 2)",
          "substitution_template": "AR = \\frac{{op_amp}}{{ip_amp}}",
          "depends_on": ["op_amp", "ip_amp"],
          "unit": "dim",
          "format": "decimal",
          "decimal_precision": 3,
          "feeds_into": "Step 5: Time Constant (τ)"
        },
        {
          "step_id": "freq",
          "step_number": 4,
          "label": "Step 4: Circular Frequency of Oscillation (ω)",
          "formula_latex": "\\omega = \\frac{2\\pi}{T}",
          "formula_expression": "2 * 3.14159265 / period",
          "substitution_template": "\\omega = \\frac{2\\pi}{{period}}",
          "depends_on": ["period"],
          "unit": "rad/s",
          "format": "decimal",
          "decimal_precision": 3,
          "feeds_into": "Step 5: Time Constant (τ)"
        },
        {
          "step_id": "tau",
          "step_number": 5,
          "label": "Step 5: System Time Constant from AR (τ)",
          "formula_latex": "\\tau = \\frac{\\sqrt{1 - AR^2}}{AR \\cdot \\omega}",
          "formula_expression": "sqrt(1 - (((op_max - op_min) / 2) / ((input_max - input_min) / 2))^2) / ((((op_max - op_min) / 2) / ((input_max - input_min) / 2)) * (2 * 3.14159265 / period))",
          "substitution_template": "\\tau = \\frac{\\sqrt{1 - ({AR})^2}}{{AR} \\times {freq}}",
          "simplification_template": "\\tau = \\frac{0.9539}{0.03142}",
          "depends_on": ["AR", "freq"],
          "unit": "sec",
          "format": "decimal",
          "decimal_precision": 2
        },
        {
          "step_id": "phase_lag",
          "step_number": 6,
          "label": "Step 6: Phase Lag Angle (φ)",
          "formula_latex": "\\phi = \\frac{\\text{obs phase lag} \\times 360}{T}",
          "formula_expression": "(obs_phase_lag * 360) / period",
          "substitution_template": "\\phi = \\frac{{obs_phase_lag} \\times 360}{{period}}",
          "depends_on": ["obs_phase_lag", "period"],
          "unit": "°",
          "format": "decimal",
          "decimal_precision": 1
        }
      ],
      "fixed_inputs": [
        { "id": "input_max", "label": "Max Bath Temp", "value": 48.0, "unit": "°C", "description": "Maximum input bath temperature" },
        { "id": "input_min", "label": "Min Bath Temp", "value": 28.0, "unit": "°C", "description": "Minimum input bath temperature" },
        { "id": "op_max", "label": "Max Thermowell", "value": 43.0, "unit": "°C", "description": "Maximum thermowell output temperature" },
        { "id": "op_min", "label": "Min Thermowell", "value": 37.0, "unit": "°C", "description": "Minimum thermowell output temperature" },
        { "id": "period", "label": "Period of Oscillation (T)", "value": 60.0, "unit": "sec", "description": "Cycle duration in seconds" },
        { "id": "obs_phase_lag", "label": "Observed Phase Lag", "value": 10.0, "unit": "sec", "description": "Observed peak time shift" }
      ],
      "trial_inputs": [
        { "id": "t", "label": "Time (s)", "unit": "s", "type": "number", "placeholder": "e.g. 15", "tooltip": "Elapsed time in seconds" },
        { "id": "T_in", "label": "Input Temp (°C)", "unit": "°C", "type": "number", "placeholder": "e.g. 48", "tooltip": "Bath temperature" },
        { "id": "T_out", "label": "Output Temp (°C)", "unit": "°C", "type": "number", "placeholder": "e.g. 41.5", "tooltip": "Thermowell sensor temperature" }
      ],
      "calculations": {
        "ip_amp": "(input_max - input_min) / 2",
        "op_amp": "(op_max - op_min) / 2",
        "AR": "((op_max - op_min) / 2) / ((input_max - input_min) / 2)",
        "freq": "2 * 3.14159265 / period",
        "tau": "sqrt(1 - (((op_max - op_min) / 2) / ((input_max - input_min) / 2))^2) / ((((op_max - op_min) / 2) / ((input_max - input_min) / 2)) * (2 * 3.14159265 / period))",
        "phase_lag": "(obs_phase_lag * 360) / period",
        "theta_A": "0.1365"
      },
      "calculated_columns": [
        { "id": "T_in", "label": "Input Bath (°C)", "unit": "°C", "format": "decimal" },
        { "id": "T_out", "label": "Output Sensor (°C)", "unit": "°C", "format": "decimal" }
      ],
      "validation_ranges": {
        "t": { "min": 0, "max": 1000, "label": "Time (s)" },
        "T_in": { "min": 20, "max": 80, "label": "Input Temp (°C)" },
        "T_out": { "min": 20, "max": 80, "label": "Output Temp (°C)" }
      },
      "sample_data": [
        { "t": 0, "T_in": 38, "T_out": 40 },
        { "t": 15, "T_in": 48, "T_out": 41.5 },
        { "t": 30, "T_in": 38, "T_out": 37 },
        { "t": 45, "T_in": 28, "T_out": 39.5 },
        { "t": 60, "T_in": 38, "T_out": 43 },
        { "t": 75, "T_in": 48, "T_out": 40 },
        { "t": 90, "T_in": 38, "T_out": 37 },
        { "t": 105, "T_in": 28, "T_out": 40 },
        { "t": 120, "T_in": 38, "T_out": 43 },
        { "t": 135, "T_in": 48, "T_out": 40 },
        { "t": 150, "T_in": 38, "T_out": 37 },
        { "t": 165, "T_in": 28, "T_out": 40 },
        { "t": 180, "T_in": 38, "T_out": 43 },
        { "t": 195, "T_in": 48, "T_out": 40 },
        { "t": 210, "T_in": 38, "T_out": 37 }
      ],
      "graph": {
        "type": "first_order_sinusoidal",
        "x": "t",
        "y": "T_out",
        "x_label": "Time (sec)",
        "y_label": "Temperature (°C)",
        "title": "Sinusoidal Response of Thermal Bath (Input vs Output Temperature Overlay)"
      }
    }
  ]
}
